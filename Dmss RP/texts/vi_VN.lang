guide.welcome=Xin chào nhà thám hiểm!\n\nĐây là sách hướng dẫn của bạn.\n\nHãy dùng nó để tìm hiểu về addon và toàn bộ tính năng của nó. Một số chủ đề hiện có thể đang bị khóa nhưng sẽ được mở khóa sau.\n\n

guide.tameable=Có Thể Thuần Phục
guide.boss=Boss
guide.general_dragon1=Rồng có thể thuần phục là những sinh vật phép thuật có thể bay giống Ghast và dùng cú nhảy mạnh để bắt đầu bay.\n\n
guide.general_dragon2=Mỗi loại rồng đều có vật phẩm thuần phục và hồi máu riêng. Rồng cưỡi được có thể trang bị cả yên và rương chứa đồ. Khi tương tác với nó trong lúc cầm chai thủy tinh, nó sẽ đổ đầy hơi thở rồng vào chai.
guide.general_dragon3=Ngoài ra, khi cưỡi rồng và tương tác với nó, rồng sẽ bắn ra một luồng đạn.\n\n
guide.general_dragon4=\n\nRồng pha lê có thể được triệu hồi qua một bàn thờ đặc biệt cùng một vật tổ độc nhất (xem thêm ở phần Nguyên Liệu Đặc Biệt). Rồng pha lê không thể bay nhưng sở hữu nhiều đòn tấn công mạnh mẽ và thù địch với người chơi. Hãy đánh bại chúng để nhận vật phẩm rơi ra.
guide.acacia_dragon=§3Rồng Keo
guide.acacia_dragon_general=\nRồng Keo là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.acacia_dragon_tame=Vật Phẩm Thuần Phục:  Lá keo và cây con keo\n\n\n
guide.acacia_dragon_heal=Vật Phẩm Hồi Máu:  Lá keo, cây con keo, gỗ tròn, ván gỗ, cỏ\n\n\n
guide.acacia_dragon_breed=Vật Phẩm Nhân Giống:  Cây con keo và cỏ\n\n
guide.azalea_dragon=§3Rồng Đỗ Quyên
guide.azalea_dragon_general=\nRồng Đỗ Quyên là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.azalea_dragon_tame=Vật Phẩm Thuần Phục:  Lá đỗ quyên và cây con đỗ quyên\n\n\n
guide.azalea_dragon_heal=Vật Phẩm Hồi Máu:  Lá đỗ quyên, cây con đỗ quyên, gỗ tròn, ván gỗ, hoa bào tử và lá nhỏ giọt\n\n\n
guide.azalea_dragon_breed=Vật Phẩm Nhân Giống:  Cây con đỗ quyên và hoa bào tử và lá nhỏ giọt\n\n
guide.birch_dragon=§3Rồng Bạch Dương
guide.birch_dragon_general=\nRồng Bạch Dương là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.birch_dragon_tame=Vật Phẩm Thuần Phục:  Lá bạch dương và cây con bạch dương\n\n\n
guide.birch_dragon_heal=Vật Phẩm Hồi Máu:  Lá bạch dương, cây con bạch dương, gỗ tròn, ván gỗ, hoa dại\n\n\n
guide.birch_dragon_breed=Vật Phẩm Nhân Giống:  Cây con bạch dương và hoa dại\n\n
guide.cherry_dragon=§3Rồng Anh Đào
guide.cherry_dragon_general=\nRồng Anh Đào là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.cherry_dragon_tame=Vật Phẩm Thuần Phục:  Lá anh đào và cây con anh đào\n\n\n
guide.cherry_dragon_heal=Vật Phẩm Hồi Máu:  Lá anh đào, cây con anh đào, gỗ tròn, ván gỗ, cánh hoa hồng\n\n\n
guide.cherry_dragon_breed=Vật Phẩm Nhân Giống:  Cây con anh đào và cánh hoa hồng\n\n
guide.dark_oak_dragon=§3Rồng Sồi Sẫm Màu
guide.dark_oak_dragon_general=\nRồng Sồi Sẫm Màu là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.dark_oak_dragon_tame=Vật Phẩm Thuần Phục:  Lá sồi sẫm màu và cây con sồi sẫm màu\n\n\n
guide.dark_oak_dragon_heal=Vật Phẩm Hồi Máu:  Lá sồi sẫm màu, cây con sồi sẫm màu, gỗ tròn, ván gỗ, nấm đỏ và nấm nâu\n\n\n
guide.dark_oak_dragon_breed=Vật Phẩm Nhân Giống:  Cây con sồi sẫm màu và nấm đỏ và nấm nâu\n\n
guide.jungle_dragon=§3Rồng Nhiệt Đới
guide.jungle_dragon_general=\nRồng Nhiệt Đới là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.jungle_dragon_tame=Vật Phẩm Thuần Phục:  Lá nhiệt đới và cây con nhiệt đới\n\n\n
guide.jungle_dragon_heal=Vật Phẩm Hồi Máu:  Lá nhiệt đới, cây con nhiệt đới, gỗ tròn, ván gỗ, hạt cacao\n\n\n
guide.jungle_dragon_breed=Vật Phẩm Nhân Giống:  Cây con nhiệt đới và hạt cacao\n\n
guide.mangrove_dragon=§3Rồng Đước
guide.mangrove_dragon_general=\nRồng Đước là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.mangrove_dragon_tame=Vật Phẩm Thuần Phục:  Lá đước và cây con đước\n\n\n
guide.mangrove_dragon_heal=Vật Phẩm Hồi Máu:  Lá đước, cây con đước, gỗ tròn, ván gỗ, hoa súng\n\n\n
guide.mangrove_dragon_breed=Vật Phẩm Nhân Giống:  Cây con đước và hoa súng\n\n
guide.oak_dragon=§3Rồng Sồi
guide.oak_dragon_general=\nRồng Sồi là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.oak_dragon_tame=Vật Phẩm Thuần Phục:  Lá sồi và cây con sồi\n\n\n
guide.oak_dragon_heal=Vật Phẩm Hồi Máu:  Lá sồi, cây con sồi, gỗ tròn, ván gỗ, lá rụng\n\n\n
guide.oak_dragon_breed=Vật Phẩm Nhân Giống:  Cây con sồi và lá rụng\n\n
guide.pale_oak_dragon=§3Rồng Sồi Nhợt Nhạt
guide.pale_oak_dragon_general=\nRồng Sồi Nhợt Nhạt là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.pale_oak_dragon_tame=Vật Phẩm Thuần Phục:  Lá sồi nhợt nhạt và cây con sồi nhợt nhạt\n\n\n
guide.pale_oak_dragon_heal=Vật Phẩm Hồi Máu:  Lá sồi nhợt nhạt, cây con sồi nhợt nhạt, gỗ tròn, ván gỗ, hoa mắt\n\n\n
guide.pale_oak_dragon_breed=Vật Phẩm Nhân Giống:  Cây con sồi nhợt nhạt và hoa mắt\n\n
guide.spruce_dragon=§3Rồng Vân Sam
guide.spruce_dragon_general=\nRồng Vân Sam là một biến thể của Rồng Rừng, chia sẻ sức mạnh phép thuật với nhau.\n
guide.spruce_dragon_tame=Vật Phẩm Thuần Phục:  Lá vân sam và cây con vân sam\n\n\n
guide.spruce_dragon_heal=Vật Phẩm Hồi Máu:  Lá vân sam, cây con vân sam, gỗ tròn, ván gỗ, quả việt quất ngọt\n\n\n
guide.spruce_dragon_breed=Vật Phẩm Nhân Giống:  Cây con vân sam và quả việt quất ngọt\n\n
guide.sculk_dragon=§3Rồng Sculk
guide.sculk_dragon_general=\nRồng Sculk sống trong vùng sâu tối tăm, luôn phải trốn chạy khỏi Người Gác Cổng.\n
guide.sculk_dragon_tame=Vật Phẩm Thuần Phục:  Cảm biến sculk và chất xúc tác sculk\n\n\n
guide.sculk_dragon_heal=Vật Phẩm Hồi Máu:  Khối sculk\n\n\n
guide.sculk_dragon_breed=Vật Phẩm Nhân Giống:  Mảnh vọng âm\n\n

guide.lapis_drake=§dRồng Ngọc Lưu Ly
guide.lapis_drake_general=Rồng Ngọc Lưu Ly thuộc họ rồng pha lê sống sâu dưới lòng đất. Bản tính sống ẩn dật khiến nó trở nên hung dữ với con người và không thể thuần phục. Tiêu diệt nó sẽ thưởng cho bạn một mảnh sức mạnh của nó. Giống các đồng loại, nó canh giữ một bàn thờ quyền năng chôn sâu dưới lòng đất (xem thêm ở phần Nguyên Liệu Đặc Biệt).
guide.emerald_drake=§5Rồng Ngọc Lục Bảo
guide.emerald_drake_general=Rồng Ngọc Lục Bảo thuộc họ rồng pha lê sinh sống sâu trong các hang động tươi tốt dưới lòng đất. Được kính trọng vì sự khôn ngoan và hiếm có, nó bảo vệ quyết liệt kho báu của lòng đất (xem thêm ở phần Nguyên Liệu Đặc Biệt). Dù không thể thuần phục, đánh bại nó có thể mang lại một mảnh sức mạnh của nó.
guide.gold_drake=§4Rồng Vàng
guide.gold_drake_general=Rồng Vàng thuộc họ rồng pha lê, xuất hiện cả trong các hang động rực lửa của Địa Ngục lẫn những hầm mỏ sâu nhất Thế Giới Chính. Lớp vảy rực rỡ của nó ánh lên vẻ tham lam và quyền lực, lãnh thổ của nó được bảo vệ hết sức dữ dội. Dù không thể thuần phục, những ai đánh bại được nó có thể tìm thấy một mảnh sức mạnh của nó cùng bàn thờ cổ xưa mà mọi rồng pha lê bảo vệ (xem thêm ở phần Nguyên Liệu Đặc Biệt).
guide.quartz_drake=§2Rồng Thạch Anh
guide.quartz_drake_general=Rồng Thạch Anh thuộc họ rồng pha lê, sinh sống trong vùng sâu rực lửa của Địa Ngục. Cơ thể pha lê của nó tỏa ra sức nóng dữ dội và nó tấn công bất kỳ kẻ xâm nhập nào không chút do dự. Dù không thể thuần phục, đánh bại nó sẽ mang lại một mảnh sức mạnh của nó. Nó cũng canh giữ bàn thờ cổ xưa chung của các rồng pha lê (xem thêm ở phần Nguyên Liệu Đặc Biệt).
guide.redstone_drake=§bRồng Đá Đỏ
guide.redstone_drake_general=Rồng Đá Đỏ thuộc họ rồng pha lê, được truyền vào nguồn năng lượng sống của lòng đất. Cơ thể nó rực sáng năng lượng, phát sáng mờ ảo trong những đường hầm tối tăm mà nó gọi là nhà. Loài rồng này cực kỳ hung dữ và không thể thuần phục. Như mọi rồng pha lê khác, nó bảo vệ bàn thờ cổ xưa rung động năng lượng bên dưới thế giới (xem thêm ở phần Nguyên Liệu Đặc Biệt).

guide.general_egg1=Trứng rồng có thể được tìm thấy khắp thế giới trong các tổ rồng.\n\nQuá trình nở trứng bắt đầu khi bạn tương tác với quả trứng.\n\n
guide.general_egg2=Bắt đầu quá trình nở trứng sẽ mở khóa toàn bộ thông tin về loại trứng này. Nếu không tự động mở khóa, bạn có thể tương tác với quả trứng đang nở trong lúc cầm sách hướng dẫn để mở khóa nó.\n\n
guide.general_egg3=Sau khoảng 20 phút, khi trứng nở, nó sẽ mở khóa toàn bộ thông tin về loại rồng đó.\n\n
guide.general_egg4=Nếu tương tác trong lúc rón rén, quả trứng sẽ chuyển về dạng vật phẩm để có thể nhặt lại.\n\n\n
guide.general_egg5=Trứng có thể thay đổi loại khi bắt đầu quá trình nở nhưng chỉ khi hội đủ điều kiện phù hợp.
guide.egg_acacia=§3Trứng Keo
guide.egg_acacia_general=Trứng Keo có thể được tìm thấy trong các tổ ở xa-van.\n\n
guide.egg_acacia_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_azalea=§3Trứng Đỗ Quyên
guide.egg_azalea_general=Trứng Đỗ Quyên có thể được tìm thấy trong các tổ ở hang động tươi tốt.\n\n
guide.egg_azalea_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_birch=§3Trứng Bạch Dương
guide.egg_birch_general=Trứng Bạch Dương có thể được tìm thấy trong các tổ ở rừng bạch dương.\n\n
guide.egg_birch_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_cherry=§3Trứng Anh Đào
guide.egg_cherry_general=Trứng Anh Đào có thể được tìm thấy trong các tổ ở khu vực anh đào.\n\n
guide.egg_cherry_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_dark_oak=§3Trứng Sồi Sẫm Màu
guide.egg_dark_oak_general=Trứng Sồi Sẫm Màu có thể được tìm thấy trong các tổ ở rừng sồi sẫm màu rậm rạp.\n\n
guide.egg_dark_oak_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_jungle=§3Trứng Nhiệt Đới
guide.egg_jungle_general=Trứng Nhiệt Đới có thể được tìm thấy trong các tổ ở rừng nhiệt đới.\n\n
guide.egg_jungle_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_mangrove=§3Trứng Đước
guide.egg_mangrove_general=Trứng Đước có thể được tìm thấy trong các tổ ở đầm lầy đước.\n\n
guide.egg_mangrove_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_oak=§3Trứng Sồi
guide.egg_oak_general=Trứng Sồi có thể được tìm thấy trong các tổ ở rừng và thỉnh thoảng ở đồng bằng.\n\n
guide.egg_oak_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_pale_oak=§3Trứng Sồi Nhợt Nhạt
guide.egg_pale_oak_general=Trứng Sồi Nhợt Nhạt có thể được tìm thấy trong các tổ ở khu vườn nhợt nhạt.\n\n
guide.egg_pale_oak_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_spruce=§3Trứng Vân Sam
guide.egg_spruce_general=Trứng Vân Sam có thể được tìm thấy trong các tổ ở taiga.\n\n
guide.egg_spruce_speed=Vật phẩm để đẩy nhanh quá trình nở trứng:    Bột xương
guide.egg_sculk=§3Trứng Sculk
guide.egg_sculk_general=Trứng Sculk có thể được tìm thấy trong vùng sâu tối tăm.\n\n
guide.egg_sculk_speed=Không thể đẩy nhanh quá trình nở trứng

guide.spellstone_staff_wand=Đá Phép, Trượng Và Đũa Phép
guide.soulstone=Đá Linh Hồn
guide.altar=Bàn Thờ
guide.transform=Biến Đổi Trứng
guide.special_general=Ở phần này liệt kê tất cả vật phẩm mới cùng khả năng của chúng. Lưu ý một số công thức có thể chưa được mở khóa.
guide.totem=Bạn có thể chế tạo những vật tổ đặc biệt này từ một vật tổ nguyên bản, được bao quanh bởi khối quặng tương ứng. \n\nKhi đứng trên bàn thờ và sử dụng vật tổ, rồng quặng tương ứng sẽ được triệu hồi (bàn thờ cần đặt đúng vị trí trong cấu trúc).
guide.scales=Vảy là nguyên liệu để chế tạo các loại thỏi và giáp khác nhau thông qua bàn thờ. Vảy sẽ rơi ra từ rồng thuần phục theo thời gian hoặc khi tiêu diệt một con rồng thù địch.
guide.armor=Dùng vảy rồng và bàn thờ để chế tạo giáp. Công thức giống như giáp sắt hoặc kim cương và có khả năng đặc biệt.
guide.ingots=Dùng thỏi rồng và bàn thờ Thế Giới Chính để chế tạo công cụ cho riêng bạn.
guide.tool=Dùng thỏi rồng và bàn thờ Thế Giới Chính để chế tạo cho mình những công cụ có thuộc tính đặc biệt.
guide.soulstone_text=Đá linh hồn có thể dùng để hồi sinh rồng (tương tác với bàn thờ) hoặc tạo cầu rồng.
guide.spellstone=Với sự trợ giúp của Đá Phép và bàn thờ Địa Ngục, bạn có thể chế tạo trượng hoặc đũa phép. Trượng thiên về sức mạnh tấn công trong khi đũa phép có khả năng phòng thủ hoặc hữu dụng.
guide.altar_text=Bàn thờ có thể được tìm thấy dưới lòng đất hoặc trong Địa Ngục và thường được canh giữ bởi một rồng pha lê. Bàn thờ là chìa khóa để sử dụng mọi vật phẩm liên quan đến rồng trong công thức chế tạo và chỉ có thể khai thác bằng cuốc chim rồng.
guide.orb1=Cầu rồng là một pháp bảo mạnh mẽ cho phép bạn mang theo bất kỳ con rồng đã thuần phục nào trong túi đồ. Để đưa rồng vào bên trong, chỉ cần tương tác với con rồng bằng cầu. Để thả rồng ra, chỉ cần sử dụng vật phẩm. \n\n
guide.orb2=Lưu ý rằng khi ở bên trong cầu, rồng sẽ tồn tại trong một không gian phi thời gian.
guide.transform_text=Có lời đồn rằng trong điều kiện phù hợp, một quả trứng có thể thay đổi loại của nó. Những điều kiện bí ẩn này được giữ kín. \n\nChỉ có thể tiết lộ rằng nó liên quan đến khối tổ.
guide.creator_myro=Myro: code và ý tưởng chung \n
guide.creator_tom=Tomanex: texture vật phẩm và khối \n
guide.creator_equinox=Equinox: texture cầu rồng \n\n
guide.creator_translator=Bản dịch được thực hiện bởi Việt hóa bởi YTB MODS\n

