guide.birch_dragon_general=\nDer Birken Drache gehört zur Kategorie der Walddrachen und besitzt deren Eigenschaften.\n
guide.birch_dragon_tame=Zähmgegenstand:  Birkenblätter und Birkensetzlinge\n\n\n
guide.birch_dragon_heal=Heilgegenstand:  Birkenblätter, Birkensetzlinge, Birkenstämme, Birkenplanken, Wildblumen\n\n\n
guide.birch_dragon_breed=Zuchtgegenstand:  Birkensetzling und Wildblumen\n\n
